	// ページを移動する
	//jQT.goTo("#Medal", "slideleft");
	
	// Google Log
	//LogGA("Medal", "MakeUser", 0);
	
}

/*******************************************************************************
	関数名	GetUserInfo_Success
	機能	ユーザー情報取得の完了時に実行する
	
	入力	oJSON	取得データ
	出力	なし
	
	処理概要
			1. 情報が存在しない場合
			 1.1. データなしをアラートして終了する
			2. 情報が存在する場合
			 2.1. Outputに値を表示して終了する
*******************************************************************************/
function GetUserInfo_Success(oJSON){
	
	Log("358:GetUserInfo_Success Do.");
	
	// 情報が存在しない場合　初回起動時に発生する
	if(oJSON["DATA"]["error"] == "ErrNoData"){
		
		// Userを作成する
		//DoAjax('MakeUser');

		// UDIDエラー
		aMessage = GetAlertMessage("ErrNoData","");
		ShowAlert(aMessage[0], aMessage[1]);
		
		return;
	}
	
	// 情報が存在する場合
	OutputData(oJSON["DATA"]);
	
	// データを保存する
	SaveGame("SetMedal");

	// ページを移動する
	//jQT.goTo("#Medal", "slideleft");
	
	Log("ajax_common.js 250: GetInfo goTo=>Medal");
	
	// 読み込み完了表示　→ 不要に表示しない 2017.01.15
	//aMessage = GetAlertMessage("LoadCardData","");
	// ShowAlert(aMessage[0], aMessage[1]);
	
}


/*******************************************************************************
	関数名	UpdateFriend
	機能		ご友人登録を行う。自分自身のコードや、文字数の違うコードが入力された場合は
			サーバに接続せずにエラー終了する
	
	入力		なし
	出力		なし
*******************************************************************************/
function UpdateFriend(){
	
	// 自分自身のコードを取得する
	sMyCode = $("#Medal .UserCode").text();
	
	// 入力されたコードを取得する
	sFriendCode = $("#Friend").val();
	
	// 自分自身のコードの場合
	if(sFriendCode == sMyCode){
		// エラーアラート表示をする
		aMessage = GetAlertMessage("ErrInvalidFriendCodeMe","");
		ShowAlert(aMessage[0], aMessage[1]);
		return false;
	}
	
	// 登録コードの文字数が５文字でない場合
	if(sFriendCode.length < 5){
		
		// エラーアラート表示をする
		aMessage = GetAlertMessage("ErrInvalidFriendCode","");
		ShowAlert(aMessage[0], aMessage[1]);
		return false;
	}
	
	// Ajaxを実行する
	DoAjax("UpdateFriend");
	
}
			

/*******************************************************************************
	関数名	UpdateFriend_Success
	機能	紹介者登録を成功した際の処理を実行する
	
	入力	oJSON		JSONオブジェクト
	出力	なし
*******************************************************************************/
function UpdateFriend_Success(oJSON){
	
	var sDataJSON = JSON.stringify(oJSON["DATA"]);
	OutputData(oJSON["DATA"]);
	
	// データを保存する
	SaveGame("SetMedal");
	
	// 登録完了のアラートを表示する
	aMessage = GetAlertMessage("UpdateFriend",oJSON["DATA"]["Friend"]);
	ShowAlert(aMessage[0], aMessage[1]);
	
	// Google Log
	//LogGA("Medal", "UpdateFriend", 0);
	
	
}



/*******************************************************************************
	関数名	ShowPurchaseConfirm_Success
	機能		AppStoreの購入確認フォームを表示する。
			GetMedalInfoの結果、メダルがないときにこの関数は実行される
	
	入力	oJSON		JSONオブジェクト
	出力	なし
*******************************************************************************/
function ShowPurchaseConfirm_Success(oJSON){
	
	// グローバル変数を参照する
	var sFunction = gsFunction;
	var sRole = gsPurchaseRole;
	Log("450: ShowPurchaseConfirm_Success:" + sFunction + "/" + sRole);
	var DATA = oJSON["DATA"];
	
	// ローディングを非表示にする
	ShowLoading(false);
	
	// ProductID設定 (プロダクト追加にあわせて更新！） ******************
	var aProductIds = [];
	aProductIds = {
		"Lovers":"Werewolf.Lovers",
		"Psycho":"Werewolf.Psycho",
		"Vampire":"Werewolf.Vampire",
		"Death":"Werewolf.Death",
		"Rich":"Werewolf.Rich",
		"Bat":"Werewolf.Bat2",
		"PsychoKiller":"Werewolf.PsychoKiller",
		"GreatShaman":"Werewolf.GreatShaman",
		"Cosplayer":"Werewolf.Cosplayer3",
		"Paparazzi":"Werewolf.Paparazzi",
		"Magician":"Werewolf.Magician",
		"Bomber":"Werewolf.Bomber",
		"Mentalist":"Werewolf.Mentalist",
		"DarkShaman":"Werewolf.DarkShaman",
		"Original":"Werewolf.Original"
	};
	
	Log("463: sRole=" + sRole);
	// 正しい役職が設定されていない場合
	if(aProductIds[sRole] == undefined){
		// エラーアラート表示をする
		aMessage = GetAlertMessage("ErrSendData","");
		ShowAlert(aMessage[0], aMessage[1]);
		return false;
	}
	
	// アプリの場合
	if(IsApp() == true){
		Log("4190:" + aProductIds[sRole]);
		// 購入アラートを表示する
		ShowPurchaseAlert(aProductIds[sRole], sFunction);
		return;
	} else {
		//$("#Loading").show();
		// アラートを表示して購入を完了
		ShowConfirm(aProductIds[sRole], "このカードを購入しますか？", sFunction);
		return;
		//eval(sFunction);
	}
	// GetMedalInfo_SuccessNoMedalに実行 } ******
	
}


/*******************************************************************************
	関数名	ShowMedalConfirm_Success
	機能		メダルの購入確認フォームを表示する
	
	入力	oJSON		JSONオブジェクト
	出力	なし
*******************************************************************************/
function ShowMedalConfirm_Success(oJSON){
	
	// グローバル変数を参照する
	var sFunction = "DoAjax('BuyCard')";
	var sRole = gsPurchaseRole;
	
	var DATA = oJSON["DATA"];
	
	// メッセージを取得する
	var	aMessage = GetAlertMessage("BuyCardByMedal", DATA["PointLast"]);
	
	// ローディングを非表示にする
	ShowLoading(false);
	
	// 実行確認フォームを表示する
	ShowConfirm(aMessage[0], aMessage[1], sFunction);
	
	return;
}

