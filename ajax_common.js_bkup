/*******************************************************************************
	関数名	MakeCheckCode
	機能	チェックコードを作成する。UDIDと秘密鍵と日付からコードを作成する
	
	入力	sUDID		UDIDコード
	出力	sCheckCode	チェックコード
*******************************************************************************/
function MakeCheckCode(sUDID){
	// 秘密鍵
	var sSecret = "mo61";
	
	var sCode = sUDID + sSecret;
	
	var sCheckCode = CRYPT.MD5.calc(sCode);
	//var sCheckCode = MD5_hexhash(sCode);
	
	return sCheckCode;
	
}

/*******************************************************************************
	関数名	CampMedal_Success
	機能		メダルの付与を成功したときの処理を実行する
	
	入力	oJSON		JSONオブジェクト
	出力	なし
*******************************************************************************/
function CampMedal_Success(oJSON){
	
	var sDataJSON = JSON.stringify(oJSON["DATA"]);
	OutputData(oJSON["DATA"], oJSON["result"]);

	// データを保存する
	SaveGame("SetMedal");
	
	// 登録完了のアラートを表示する
	if(oJSON["DATA"]["CampType"] != "FOXIV"){
		aMessage = GetAlertMessage("CampMedal",oJSON["DATA"]["PlusPoint"]);
		ShowAlert(aMessage[0], aMessage[1]);
	}
	
}
